<UserControl x:Class="FourthIBTracker.Views.PromotionalCourseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <wv2:WebView2 x:Name="Fetcher" Width="0" Height="0" Visibility="Hidden"/>

        <DockPanel Margin="20">
            <DockPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource H1}" Text="Latest Promotional Course"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="Open course ↗" Padding="12,5" Margin="0,0,7,0"
                            Command="{Binding OpenCourseCommand}"/>
                    <Button Content="↻ Refresh" Padding="12,5" FontWeight="SemiBold"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap"
                       Foreground="{StaticResource Danger}" Margin="0,0,0,4"/>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding Course.Title}" FontSize="19" FontWeight="Bold"
                                           Foreground="{StaticResource TextMain}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Course.DateText}" FontSize="14"
                                           Foreground="{StaticResource Accent}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Course.SignupDeadline}" FontSize="13"
                                           Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>

                                <TextBlock Text="Prerequisites" FontSize="15.5" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}" Margin="0,16,0,6"/>
                                <ItemsControl ItemsSource="{Binding Course.Prerequisites}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#22000000" CornerRadius="5"
                                                    Padding="9,5" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextMain}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Expander Header="Full course information" Margin="0,14,0,0"
                                          Foreground="{StaticResource TextMain}">
                                    <TextBlock Text="{Binding Course.Details}" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextDim}" Margin="0,8,0,0"/>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMain}"
                                   Margin="0,0,0,8">
                            <Run Text="Signups — "/><Run Text="{Binding Candidates.Count, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="No one has signed up yet." Foreground="{StaticResource TextDim}"
                                   Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Candidates.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Candidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14,11">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Signup.DisplayName}" FontSize="15.5"
                                                               FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                                    <TextBlock Foreground="{StaticResource TextDim}" FontSize="12.5">
                                                        <Run Text="{Binding Signup.Unit, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Signup.Position, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding TrackerUnit, StringFormat=Tracker: {0}}"
                                                               Foreground="{StaticResource TextDim}" FontSize="11.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <Trigger Property="Text" Value="Tracker: ">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding TrackerNote}" Foreground="{StaticResource Warn}"
                                                               FontSize="11.5" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#22000000"
                                                        CornerRadius="8" Padding="9,3" Margin="8,0,0,0"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding OverallLabel}"
                                                               Foreground="{Binding OverallColor}"
                                                               FontWeight="Bold" FontSize="12.5"/>
                                                </Border>
                                                <Button Grid.Column="2" Content="Post ↗" Padding="9,3"
                                                        Margin="8,0,0,0" VerticalAlignment="Top"
                                                        Command="{Binding DataContext.OpenSignupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Prerequisites}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24"/>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="3*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Symbol}" Foreground="{Binding Color}"
                                                                       FontWeight="Bold" FontSize="15"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Prerequisite}"
                                                                       Foreground="{StaticResource TextMain}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                                       Foreground="{StaticResource TextDim}"
                                                                       TextWrapping="Wrap" Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>

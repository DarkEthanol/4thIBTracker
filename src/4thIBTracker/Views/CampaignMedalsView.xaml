<UserControl x:Class="FourthIBTracker.Views.CampaignMedalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Campaign Medals"/>
                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextDim}"
                           FontSize="13" Margin="0,-5,0,8"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="↻ Refresh" Padding="12,5"
                    FontWeight="SemiBold" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Command="{Binding LoadCommand}"/>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                   Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding UnmatchedMessage}"
                   Foreground="{StaticResource Warn}" FontSize="12.5"
                   TextWrapping="Wrap" Margin="0,0,0,5"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}"
                   Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                   Margin="0,0,0,5"/>
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <Grid>
            <Border Margin="0,4,0,0"
                    VerticalAlignment="Top" MaxWidth="620" HorizontalAlignment="Left">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoRequirements}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" Foreground="{StaticResource Accent}"
                               FontSize="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Everyone with an Outcomes record has their current medal."
                               Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="500">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"
                                                   Margin="0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}"
                                                   HorizontalAlignment="Right" FontSize="12.5"
                                                   Foreground="{StaticResource Warn}"/>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Soldiers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1"
                                                        Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="155"/>
                                                            <ColumnDefinition Width="95"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextMain}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" FontSize="12.5"
                                                                   Foreground="{StaticResource TextDim}"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="{Binding Deployments, Mode=OneWay}"/><Run Text=" deployments"/>
                                                        </TextBlock>
                                                        <StackPanel Grid.Column="2">
                                                            <Border Background="#4A3A2A" CornerRadius="8"
                                                                    Padding="8,2" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Medal}"
                                                                           Foreground="{StaticResource Warn}"
                                                                           FontSize="12.5" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding PreviousAward}" FontSize="11.5"
                                                                       Foreground="{StaticResource TextDim}"
                                                                       Margin="2,3,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>

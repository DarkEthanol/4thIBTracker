<UserControl x:Class="FourthIBTracker.Views.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="TodoItem">
            <Border BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" Padding="0,9">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="✕" ToolTip="Delete task"
                            Margin="10,0,0,0" Padding="7,3" VerticalAlignment="Center"
                            Foreground="{StaticResource TextDim}"
                            Command="{Binding DataContext.DeleteTaskCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Center"
                              Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="15" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="12.5" Text="{Binding DueLabel}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding RecurrenceLabel}" FontSize="12"
                                   Foreground="{StaticResource Accent}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Todo"/>
            <Button DockPanel.Dock="Right" Content="↻ Refresh" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Padding="10,5" Command="{Binding RefreshCommand}"/>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="175"/>
                            <ColumnDefinition Width="225"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="4" Style="{StaticResource H2}" Text="ADD A TASK"/>
                        <TextBlock Grid.Row="1" Text="Task" Foreground="{StaticResource TextDim}"
                                   Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Due date"
                                   Foreground="{StaticResource TextDim}" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Repeat"
                                   Foreground="{StaticResource TextDim}" Margin="0,0,10,4"/>

                        <TextBox Grid.Row="2" Margin="0,0,10,0" FontSize="15"
                                 Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddTaskCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <DatePicker Grid.Row="2" Grid.Column="1" Margin="0,0,10,0"
                                    SelectedDate="{Binding NewTaskDueDate}"/>
                        <ComboBox Grid.Row="2" Grid.Column="2" Margin="0,0,10,0"
                                  ItemsSource="{Binding RecurrenceOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding NewTaskRecurrence}"
                                  ToolTip="For monthly dates from 29–31, shorter months use their final day."/>
                        <Button Grid.Row="2" Grid.Column="3" Content="Add task"
                                Background="{StaticResource AccentDim}" FontWeight="SemiBold"
                                Command="{Binding AddTaskCommand}"/>

                        <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource Warn}" Margin="0,7,0,0"/>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Style="{StaticResource H2}" Text="OUTSTANDING"/>
                                <Border DockPanel.Dock="Right" Background="{StaticResource Danger}"
                                        CornerRadius="10" Padding="7,2" Margin="8,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OverdueCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Foreground="White" FontWeight="Bold">
                                        <Run Text="{Binding OverdueCount}"/><Run Text=" overdue"/>
                                    </TextBlock>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="No outstanding tasks. Add one above when you need it."
                                       Foreground="{StaticResource TextDim}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OpenItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding OpenItems}"
                                          ItemTemplate="{StaticResource TodoItem}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="COMPLETED"/>
                            <TextBlock Text="Completed one-off tasks will appear here. Recurring tasks advance to their next date."
                                       Foreground="{StaticResource TextDim}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompletedItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding CompletedItems}"
                                          ItemTemplate="{StaticResource TodoItem}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

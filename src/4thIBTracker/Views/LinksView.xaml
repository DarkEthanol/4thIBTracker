<UserControl x:Class="FourthIBTracker.Views.LinksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Links"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBox Width="240" Margin="0,0,8,0" Padding="6,4"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="↻ Refresh" Padding="10,5" Command="{Binding LoadCommand}"/>
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap"
                   Foreground="{StaticResource Danger}" Margin="0,0,0,4"/>
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Name}" FontSize="19.5" FontWeight="Bold"
                                           Foreground="{StaticResource TextMain}"/>
                                <Border Background="#33FFFFFF" Height="1" Margin="12,0,0,0"
                                        VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Links}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="320" Margin="0,0,12,10" Cursor="Hand"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.OpenCommand,
                                                          RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{StaticResource BgPanel}"
                                                            CornerRadius="6" Padding="14,10">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#353A3F"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" FontSize="13.5" Margin="0,3,0,0"
                                                           Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                                           MaxHeight="40" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>

<UserControl x:Class="FourthIBTracker.Views.PatrolFillInsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <wv2:WebView2 x:Name="Fetcher" Width="0" Height="0" Visibility="Hidden"/>

        <DockPanel Margin="20">
            <DockPanel DockPanel.Dock="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Patrol Report Fill-ins"/>
                    <TextBlock Text="People listed outside their normal HQ or section, compared with the website and SuT ORBATs."
                               Foreground="{StaticResource TextDim}" Margin="0,-8,0,10"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="Month" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="180" Margin="0,0,8,0"
                              ItemsSource="{Binding MonthOptions}"
                              SelectedItem="{Binding SelectedMonth}"/>
                    <Button Content="↻ Scan" Padding="12,5" FontWeight="SemiBold"
                            Command="{Binding ScanCommand}"/>
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource Accent}" Margin="0,0,0,4"
                       TextWrapping="Wrap"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap"
                       Foreground="{StaticResource Danger}" Margin="0,0,0,4"/>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <Grid>
                <TextBlock Text="No fill-ins were found for the selected month."
                           Foreground="{StaticResource TextDim}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasData}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Nights}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="430">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,7">
                                            <TextBlock Text="{Binding Title}" FontSize="16.5"
                                                       FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding People}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1"
                                                            Padding="0,6">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="Report ↗"
                                                                    Padding="9,3" Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Command="{Binding DataContext.OpenCommand,
                                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="14"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextMain}"/>
                                                                <TextBlock Text="{Binding Detail}" FontSize="12.5"
                                                                           Foreground="{StaticResource TextDim}"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>

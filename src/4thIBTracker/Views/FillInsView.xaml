<UserControl x:Class="FourthIBTracker.Views.FillInsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Fill-in Submissions"/>
            <Button DockPanel.Dock="Right" Content="↻ Reload roster" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Padding="10,5" Command="{Binding LoadCommand}"/>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                   Foreground="{StaticResource Accent}" Margin="0,0,0,2"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap"
                   Foreground="{StaticResource Danger}" Margin="0,0,0,2"/>
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Event settings -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Date of filling in:" Foreground="{StaticResource TextMain}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding EventDate}" Width="140" Margin="0,0,24,0"/>
                <TextBlock Text="Where did they fill in?" Foreground="{StaticResource TextMain}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding WhereOptions}" SelectedItem="{Binding WhereFilledIn}"
                          Width="150"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Roster picker -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="UNIT ROSTER"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Add ▸" Padding="14,6" Margin="8,0,0,0"
                                FontWeight="SemiBold" Command="{Binding AddCommand}"/>
                        <Grid>
                            <TextBox x:Name="SearchBox" Padding="8,6"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Search names… (double-click a row to add)"
                                       Foreground="#66FFFFFF" Margin="10,0,0,0" FontSize="13.5"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding FilteredSoldiers}"
                             SelectedItem="{Binding SelectedSoldier}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextMain}"
                             MouseDoubleClick="Roster_MouseDoubleClick"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                                    Padding="10,7" Margin="0,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDim}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="#26FFFFFF" CornerRadius="9"
                                            Padding="9,2" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Origin}" FontSize="12"
                                                   Foreground="{StaticResource TextDim}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="15"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMain}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Pending submissions -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource H2}" Text="TO SUBMIT"/>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="13"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center">
                            <Run Text="{Binding Pending.Count, Mode=OneWay}"/><Run Text=" queued"/>
                        </TextBlock>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Submit all" Padding="18,8" FontWeight="Bold" FontSize="15"
                                Background="{StaticResource Accent}" Foreground="#1E2124"
                                Command="{Binding SubmitAllCommand}" Margin="0,0,8,0"/>
                        <Button Content="Clear submitted" Padding="12,8"
                                Command="{Binding ClearSubmittedCommand}"/>
                    </StackPanel>

                    <Grid>
                        <TextBlock Text="Nothing queued yet.&#10;&#10;Double-click a name on the roster (or search and hit Add) — their origin fills in automatically."
                                   Foreground="{StaticResource TextDim}" FontSize="14" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" MaxWidth="340">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Pending.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Pending}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A1D20" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="✕" Width="26" Height="26"
                                                        Margin="8,0,0,0" ToolTip="Remove" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <ComboBox DockPanel.Dock="Right" Width="150" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.FromOptions,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedItem="{Binding From}">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSubmitted}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextMain}"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="12.5"
                                                               Foreground="{StaticResource Accent}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

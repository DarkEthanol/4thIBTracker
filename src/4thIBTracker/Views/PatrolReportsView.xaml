<UserControl x:Class="FourthIBTracker.Views.PatrolReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <!-- Hidden fetcher: reuses the app's forum login session -->
        <wv2:WebView2 x:Name="Fetcher" Width="0" Height="0" Visibility="Hidden"/>

        <DockPanel Margin="20">
            <DockPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource H1}" Text="Patrol Reports"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ComboBox Width="280" Margin="0,0,8,0"
                              ItemsSource="{Binding Operations}"
                              SelectedItem="{Binding SelectedOperation}"
                              DisplayMemberPath="Name"/>
                    <Button Content="↻ Scan" Padding="12,5" FontWeight="SemiBold"
                            Command="{Binding ScanCommand}"/>
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap"
                       Foreground="{StaticResource Danger}" Margin="0,0,0,4"/>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Nights}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="440">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Title}" FontSize="16.5" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMain}"/>
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                    <Setter Property="Text" Value="{Binding CountLabel}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Complete}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Slots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" Padding="0,5">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Unit}" Width="92" FontWeight="SemiBold"
                                                                   FontSize="14" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMain}"/>
                                                        <Button DockPanel.Dock="Right" Content="Open ↗" Padding="9,3"
                                                                VerticalAlignment="Center" Margin="8,0,0,0"
                                                                Command="{Binding DataContext.OpenCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding Report}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSubmitted}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontSize="13.5">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="✗ Not submitted"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSubmitted}" Value="True">
                                                                                    <Setter Property="Text" Value="✓ Submitted"/>
                                                                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Border CornerRadius="8" Padding="8,1" Margin="8,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SignedOff}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Setter Property="Background" Value="{StaticResource AccentDim}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding SignedOff}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Setter Property="Background" Value="#4A3A2A"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock FontSize="11.5" FontWeight="SemiBold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding SignedOff}" Value="True">
                                                                                        <Setter Property="Text" Value="✓ signed off"/>
                                                                                        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding SignedOff}" Value="False">
                                                                                        <Setter Property="Text" Value="✗ needs sign-off"/>
                                                                                        <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Detail}" FontSize="12"
                                                                       Foreground="{StaticResource TextDim}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Reports that didn't map to a standard slot -->
                                    <ItemsControl ItemsSource="{Binding Extras}" Margin="0,6,0,0">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasExtras}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <Button DockPanel.Dock="Right" Content="Open ↗" Padding="9,3"
                                                            VerticalAlignment="Center" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.OpenCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextDim}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>

<UserControl x:Class="FourthIBTracker.Views.LoaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <wv2:WebView2 x:Name="Fetcher" Width="0" Height="0" Visibility="Hidden"/>

        <DockPanel Margin="20">
            <DockPanel DockPanel.Dock="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Operation Night LOAs"/>
                    <StackPanel Orientation="Horizontal" Margin="0,-5,0,8">
                        <Border Background="{StaticResource AccentDim}" CornerRadius="8"
                                Padding="7,1" Margin="0,0,7,0">
                            <TextBlock Text="READ ONLY" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}"/>
                        </Border>
                        <TextBlock Text="Source: platoon LOA forums · current members and sections come from the website ORBAT"
                                   Foreground="{StaticResource TextDim}" FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="Operation night" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}" FontSize="13" Margin="0,0,7,0"/>
                    <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                Width="145" Height="31" VerticalContentAlignment="Center"/>
                    <Button Content="Today" Padding="11,5" Margin="7,0,0,0"
                            Command="{Binding SelectTodayCommand}"/>
                    <Button Content="↻ Refresh" Padding="12,5" Margin="7,0,0,0"
                            FontWeight="SemiBold" Command="{Binding ScanCommand}"/>
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap"
                       Foreground="{StaticResource Danger}" Margin="0,0,0,4"/>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="440" MinHeight="150">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name}" FontSize="16.5" FontWeight="Bold"
                                                   Foreground="{StaticResource Accent}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextDim}" FontSize="12.5"/>
                                    </DockPanel>

                                    <TextBlock Text="No LOAs recorded" FontSize="13"
                                               Foreground="{StaticResource TextDim}" Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasEntries}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1"
                                                        Padding="0,7">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Open ↗" Padding="9,3"
                                                                Margin="10,0,0,0" VerticalAlignment="Center"
                                                                Command="{Binding DataContext.OpenCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextMain}"/>
                                                            <TextBlock Text="{Binding Reason}" FontSize="12.5"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{StaticResource TextDim}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="Text" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>

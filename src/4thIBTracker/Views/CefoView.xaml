<UserControl x:Class="FourthIBTracker.Views.CefoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="CEFO &amp; Coy Stores"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBox Width="240" Margin="0,0,8,0" Padding="6,4"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search roles or kit, e.g. 'GPMG' or 'smoke'"/>
                <Button Content="↻ Refresh" Padding="10,5" Command="{Binding LoadCommand}"/>
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap"
                   Foreground="{StaticResource Danger}" Margin="0,0,0,4"/>
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <!-- Group header -->
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Name}" FontSize="19.5" FontWeight="Bold"
                                           Foreground="{StaticResource TextMain}"/>
                                <Border Background="#33FFFFFF" Height="1" Margin="12,0,0,0"
                                        VerticalAlignment="Center"/>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Roles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Width="290">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Role}" FontSize="17.5" FontWeight="Bold"
                                                               Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                                                    <Border DockPanel.Dock="Right" Background="{StaticResource AccentDim}"
                                                            CornerRadius="8" Padding="7,1" VerticalAlignment="Top"
                                                            HorizontalAlignment="Right">
                                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextMain}">
                                                            <Run Text="{Binding Items.Count, Mode=OneWay}"/><Run Text=" items"/>
                                                        </TextBlock>
                                                    </Border>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
                                                                <TextBlock Text="{Binding}" FontSize="14.5" TextWrapping="Wrap"
                                                                           Foreground="{StaticResource TextMain}"
                                                                           Padding="0,2.5"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>

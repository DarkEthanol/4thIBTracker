<UserControl x:Class="FourthIBTracker.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FourthIBTracker.ViewModels"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <Style x:Key="CardLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                <Setter TargetName="Border" Property="Background" Value="#16FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AlertLink" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Tag" Value="{StaticResource Accent}"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{TemplateBinding Tag}"
                                        CornerRadius="5,0,0,5"/>
                                <ContentPresenter Grid.Column="1" Margin="12,6,12,6"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#34393E"/>
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{StaticResource AccentDim}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStatus" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <DataTemplate x:Key="TransferRow">
            <Border BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" Padding="0,4">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="↗" Width="26" Height="24"
                            Margin="6,0,0,0" ToolTip="Open thread" VerticalAlignment="Center"
                            Command="{Binding DataContext.OpenTransferCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="13.5"
                                   Foreground="{StaticResource TextMain}" TextWrapping="Wrap"/>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextDim}">
                            <Run Text="{Binding Tag, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding Date, Mode=OneWay, StringFormat='dd MMM yyyy',
                                        TargetNullValue='date unknown'}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20,12,8,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <wv2:WebView2 x:Name="Fetcher" Grid.Row="0" Width="0" Height="0" Visibility="Hidden"/>

        <DockPanel Grid.Row="0">
            <TextBlock Style="{StaticResource H1}" Text="Dashboard" Margin="0,0,0,6"/>
            <Button DockPanel.Dock="Right" Content="↻ Refresh" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Padding="10,4" Command="{Binding LoadCommand}"/>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,10,6">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <UniformGrid Columns="4">
                <Button Style="{StaticResource AlertLink}" Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static vm:DashboardDestination.Discipline}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DISCIPLINARIES" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMain}"/>
                            <TextBlock Text="Active cases" FontSize="10.5"
                                       Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding DisciplinaryAlertCount}"
                                   FontSize="21" FontWeight="Bold" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="16,0,0,0" MinWidth="24"
                                   TextAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisciplinaryAlertCount}" Value="0">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

                <Button Style="{StaticResource AlertLink}" Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static vm:DashboardDestination.Orbat}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ORBAT" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMain}"/>
                            <TextBlock Text="Mismatches" FontSize="10.5"
                                       Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding OrbatMismatchAlertCount}"
                                   FontSize="21" FontWeight="Bold" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="16,0,0,0" MinWidth="24"
                                   TextAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OrbatMismatchAlertCount}" Value="0">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

                <Button Style="{StaticResource AlertLink}" Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static vm:DashboardDestination.NcoCourses}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NCO COURSES" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMain}"/>
                            <TextBlock Text="Not scheduled" FontSize="10.5"
                                       Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding UnscheduledNcoAlertCount}"
                                   FontSize="21" FontWeight="Bold" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="16,0,0,0" MinWidth="24"
                                   TextAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UnscheduledNcoAlertCount}" Value="0">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

                <Button Style="{StaticResource AlertLink}" Margin="0,0,12,8"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static vm:DashboardDestination.Transfers}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TRANSFERS" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMain}"/>
                            <TextBlock Text="Pending requests" FontSize="10.5"
                                       Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding PendingTransferAlertCount}"
                                   FontSize="21" FontWeight="Bold" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="16,0,0,0" MinWidth="24"
                                   TextAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingTransferAlertCount}" Value="0">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>
            </UniformGrid>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="0.82*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Style="{StaticResource CardLink}"
                                Content="DISCIPLINARIES  ↗" Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:DashboardDestination.Discipline}"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DisciplineStatus}"
                                   ToolTip="{Binding DisciplineStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardStatus}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisciplineStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Top" Text="None — clean slate."
                                   Foreground="{StaticResource TextDim}" FontSize="13.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveDisciplinaries.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ActiveDisciplinaries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="0,5">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Recipient}" FontWeight="SemiBold"
                                                               FontSize="13.5" Foreground="{StaticResource TextMain}"/>
                                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                               FontSize="12.5" Foreground="{StaticResource Warn}">
                                                        <Run Text="{Binding DaysRemaining, Mode=OneWay}"/><Run Text="d left"/>
                                                    </TextBlock>
                                                </DockPanel>
                                                <TextBlock Foreground="{StaticResource TextDim}" FontSize="12"
                                                           TextWrapping="Wrap">
                                                    <Run Text="{Binding Offence, Mode=OneWay}"/><Run Text=" · "/>
                                                    <Run Text="{Binding Area, Mode=OneWay}"/><Run Text=" · "/>
                                                    <Run Text="{Binding Notes, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <Button Style="{StaticResource CardLink}" Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:DashboardDestination.NcoCourses}">
                            <TextBlock>
                                <Run Text="{Binding NcoMonthTitle, Mode=OneWay}"/><Run Text="  ↗"/>
                            </TextBlock>
                        </Button>
                        <TextBlock Text="{Binding NcoStatus}" ToolTip="{Binding NcoStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardStatus}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NcoStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding NcoChecks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                                                   FontWeight="Bold" FontSize="12" Margin="8,0,0,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsUpcoming}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource TextMain}">
                                                <Run Text="{Binding Position, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Section, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding NcoNames}" FontSize="11"
                                                       Foreground="{StaticResource TextDim}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Style="{StaticResource CardLink}"
                                Content="ORBAT SYNC  ↗" Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:DashboardDestination.Orbat}"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding OrbatSyncStatus}"
                                   ToolTip="{Binding OrbatSyncStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardStatus}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OrbatSyncStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Top" Text="✓ Matches the website ORBAT."
                                   Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="13.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OrbatInSync}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OrbatMismatches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                                           Foreground="{StaticResource Warn}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="12"
                                                           Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Style="{StaticResource CardLink}"
                            Content="LOGI ORDER  ↗" Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static vm:DashboardDestination.Logistics}"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding LogisticsStatus}"
                               ToolTip="{Binding LogisticsStatus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CardStatus}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LogisticsStatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Top" Text="Nothing ordered."
                               Foreground="{StaticResource TextDim}" FontSize="13.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LogiOrder.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LogiOrder}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2,0,8">
                                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Accent}"
                                                   FontWeight="Bold" FontSize="13" Margin="6,0,0,0"
                                                   VerticalAlignment="Center">
                                            <Run Text="×"/><Run Text="{Binding Total, Mode=OneWay}"/>
                                        </TextBlock>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Item}" FontSize="13"
                                                       Foreground="{StaticResource TextMain}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Breakdown}" FontSize="11.5"
                                                       Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Style="{StaticResource CardLink}"
                            Content="PLATOON STRENGTH  ↗" Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static vm:DashboardDestination.Orbat}"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PlatoonStrengthStatus}"
                               ToolTip="{Binding PlatoonStrengthStatus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CardStatus}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlatoonStrengthStatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" Margin="0,16,0,18">
                            <Run Text="{Binding TotalStrength, Mode=OneWay}" FontSize="42" FontWeight="Bold"
                                 Foreground="{StaticResource TextMain}"/>
                            <Run Text=" personnel" FontSize="12" Foreground="{StaticResource TextDim}"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#20FFFFFF" CornerRadius="4" Padding="9"
                                            Margin="0,0,6,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                       Foreground="{StaticResource TextDim}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Soldiers.Count}" FontSize="22"
                                                       FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.15*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Style="{StaticResource CardLink}"
                                Content="OUTSTANDING COURSES  ↗" Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:DashboardDestination.Courses}"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding OutstandingCoursesStatus}"
                                   ToolTip="{Binding OutstandingCoursesStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardStatus}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OutstandingCoursesStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CourseGaps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Outstanding}"
                                                       Foreground="{StaticResource Warn}" FontWeight="Bold"
                                                       FontSize="13" Margin="8,0,10,0"/>
                                            <TextBlock Text="{Binding Course}" FontSize="13"
                                                       Foreground="{StaticResource TextMain}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Style="{StaticResource CardLink}"
                                Content="TRANSFERS  ↗" Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:DashboardDestination.Transfers}"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding TransferStatus}"
                                   ToolTip="{Binding TransferStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardStatus}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TransferStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="PENDING" FontSize="11.5" FontWeight="Bold"
                                           Foreground="{StaticResource Warn}" Margin="0,2,0,2"/>
                                <ItemsControl ItemsSource="{Binding PendingTransfers}"
                                              ItemTemplate="{StaticResource TransferRow}"/>
                                <TextBlock Text="COMPLETED" FontSize="11.5" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}" Margin="0,10,0,2"/>
                                <ItemsControl ItemsSource="{Binding CompletedTransfers}"
                                              ItemTemplate="{StaticResource TransferRow}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="FourthIBTracker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Compact label-left / field-right row -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="RowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Settings"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Save" Padding="16,6" FontWeight="Bold"
                        Background="{StaticResource Accent}" Foreground="#1E2124"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                   Foreground="{StaticResource Accent}" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1200" HorizontalAlignment="Left">

                <!-- ============ Updates ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="APP UPDATES"/>
                        <TextBlock FontSize="13" Foreground="{StaticResource TextDim}"
                                   TextWrapping="Wrap" Margin="0,0,0,8">
                            <Run Text="Installed version: "/>
                            <Run Text="{Binding Updates.CurrentVersion, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Updates.StatusMessage}" FontSize="13"
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Check for updates" Padding="12,6"
                                    Command="{Binding Updates.CheckForUpdatesCommand}"/>
                            <Button Content="Download, install and restart" Padding="12,6"
                                    Margin="8,0,0,0" Background="{StaticResource Accent}"
                                    Foreground="#1E2124"
                                    Command="{Binding Updates.InstallUpdateCommand}"
                                    Visibility="{Binding Updates.UpdateAvailable, Converter={StaticResource BooleanToVisibility}}"/>
                            <TextBlock Text="{Binding Updates.ProgressText}" Margin="10,0,0,0"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Releases are downloaded from GitHub and checked against their SHA-256 checksum before installation. AppData is never replaced."
                                   FontSize="12" Foreground="{StaticResource TextDim}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ============ Platoon ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="PLATOON"/>
                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Platoon number"/>
                            <TextBox Grid.Column="1" Text="{Binding PlatoonNumber}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource RowLabel}" Margin="12,0,0,0"
                                       Text="drives every scan, filter and view — set the Attendance tab below to match (e.g. '4 Pl')"
                                       TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Address 'From' line"/>
                            <TextBox Grid.Column="1" Text="{Binding AddressFrom}" MaxWidth="380" HorizontalAlignment="Left" Width="380"/>
                        </Grid>
                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Address sign-off"/>
                            <TextBox Grid.Column="1" Text="{Binding SignOff}" Width="380" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="NCO tracker positions"/>
                            <TextBox Grid.Column="1" Text="{Binding NcoPositions}" Width="380" HorizontalAlignment="Left"
                                     ToolTip="Comma-separated position codes used by the NCO tracker"/>
                        </Grid>
                        <Grid Style="{StaticResource RowGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Report sign-off phrase"/>
                            <TextBox Grid.Column="1" Text="{Binding SignOffPhrase}" Width="380" HorizontalAlignment="Left"
                                     ToolTip="The exact phrase you type when signing off a patrol report"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Google access ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="GOOGLE ACCESS"/>
                        <TextBlock Text="{Binding CredentialsStatus}" FontSize="13"
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <Button Content="Import / replace credentials.json…"
                                HorizontalAlignment="Left" Padding="12,6"
                                Command="{Binding ImportCredentialsCommand}"/>
                        <TextBlock Text="The selected file is validated and copied to your Windows profile. Replacing it creates a backup and requires Google authorisation again."
                                   FontSize="12" Foreground="{StaticResource TextDim}"
                                   TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ============ Google Sheets ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="GOOGLE SHEETS"/>
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SHEET" FontSize="11" Foreground="{StaticResource TextDim}"/>
                            <TextBlock Grid.Column="1" Text="SPREADSHEET ID" FontSize="11" Foreground="{StaticResource TextDim}"/>
                            <TextBlock Grid.Column="2" Text="TAB" FontSize="11" Foreground="{StaticResource TextDim}" Margin="8,0,0,0"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Sheets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="190"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" VerticalAlignment="Center"
                                                   FontSize="13.5" Foreground="{StaticResource TextMain}"/>
                                        <TextBox Grid.Column="1" Text="{Binding Id}" FontSize="12.5"/>
                                        <TextBox Grid.Column="2" Text="{Binding Tab}" FontSize="12.5" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ Forums & web ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="Grid" BasedOn="{StaticResource RowGrid}"/>
                        </StackPanel.Resources>
                        <TextBlock Style="{StaticResource H2}" Text="FORUMS &amp; WEB"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Website ORBAT"/>
                            <TextBox Grid.Column="1" Text="{Binding OrbatUrl}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Fill-in Google Form ID"/>
                            <TextBox Grid.Column="1" Text="{Binding FillInFormId}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Operations index page"/>
                            <TextBox Grid.Column="1" Text="{Binding OperationsIndexUrl}"
                                     ToolTip="The forum page listing the current Operation and the Archives — patrol reports are auto-discovered from here"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Patrol reports (fallback)"/>
                            <TextBox Grid.Column="1" Text="{Binding PatrolReportsForumUrl}"
                                     ToolTip="Only used if the operations index isn't set"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Training reports forum"/>
                            <TextBox Grid.Column="1" Text="{Binding TrainingReportsForumUrl}"
                                     ToolTip="The single Training Reports archive; its page count is discovered automatically"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Completed courses forum"/>
                            <TextBox Grid.Column="1" Text="{Binding CoursesForumUrl}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Upcoming courses forum"/>
                            <TextBox Grid.Column="1" Text="{Binding UpcomingForumUrl}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Pending transfer forums"/>
                            <TextBox Grid.Column="1" Text="{Binding PendingTransferForums}" AcceptsReturn="True"
                                     MinHeight="48" ToolTip="One URL per line"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Completed transfer forums"/>
                            <TextBox Grid.Column="1" Text="{Binding CompletedTransferForums}" AcceptsReturn="True"
                                     MinHeight="48" ToolTip="One URL per line"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Browser tabs ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="SIDEBAR BROWSER TABS"/>
                        <TextBlock Text="One per line:  Name | https://url" FontSize="12.5"
                                   Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BrowserTabs}" AcceptsReturn="True" MinHeight="130"
                                 FontSize="12.5" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

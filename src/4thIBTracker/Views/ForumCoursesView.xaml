<UserControl x:Class="FourthIBTracker.Views.ForumCoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <!-- Hidden fetcher: reuses the app's forum login session -->
        <wv2:WebView2 x:Name="Fetcher" Width="0" Height="0" Visibility="Hidden"/>

        <DockPanel Margin="20">
            <DockPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource H1}" Text="NCO Courses"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ComboBox Width="160" Margin="0,0,8,0"
                              ItemsSource="{Binding MonthOptions}"
                              SelectedItem="{Binding SelectedMonth}"
                              ItemStringFormat="MMMM yyyy"/>
                    <Button Content="Scan forum" Padding="14,5" FontWeight="SemiBold"
                            Command="{Binding ScanCommand}"/>
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource TextDim}" FontSize="13.5"
                       Margin="0,0,0,8" TextWrapping="Wrap">
                <Run Text="Watching for threads by: "/><Run Text="{Binding NcoNamesDisplay, Mode=OneWay}"
                     FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap"
                       Foreground="{StaticResource Danger}" Margin="0,0,0,4"/>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <DataTemplate x:Key="ThreadCard">
                        <Border Style="{StaticResource Card}" Padding="14,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Open ↗" Padding="10,4"
                                        VerticalAlignment="Center" Margin="10,0,0,0"
                                        Command="{Binding DataContext.OpenCommand,
                                                  RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                        CommandParameter="{Binding}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMain}" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="13" Foreground="{StaticResource TextDim}" Margin="0,3,0,0">
                                        <Run Text="{Binding Author, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Date, Mode=OneWay, StringFormat='dd MMM yyyy', TargetNullValue='date unknown'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ScrollViewer.Resources>
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock FontSize="19.5" FontWeight="Bold" Foreground="{StaticResource TextMain}">
                            <Run Text="Completed — "/><Run Text="{Binding SelectedMonth, Mode=OneWay, StringFormat='MMMM yyyy'}"/>
                        </TextBlock>
                        <Border Background="#33FFFFFF" Height="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="None found." Foreground="{StaticResource TextDim}" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource ThreadCard}"/>

                    <DockPanel Margin="0,14,0,8">
                        <TextBlock Text="Upcoming" FontSize="19.5" FontWeight="Bold"
                                   Foreground="{StaticResource TextMain}"/>
                        <Border Background="#33FFFFFF" Height="1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="None scheduled." Foreground="{StaticResource TextDim}" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Upcoming.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Upcoming}" ItemTemplate="{StaticResource ThreadCard}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>

<UserControl x:Class="FourthIBTracker.Views.PlatoonAttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <!-- Hidden fetcher: shares the forum login used by the app's browser tabs. -->
        <wv2:WebView2 x:Name="Fetcher" Width="0" Height="0" Visibility="Hidden"/>

        <DockPanel Margin="20">
            <DockPanel DockPanel.Dock="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Website Attendance History"/>
                    <StackPanel Orientation="Horizontal" Margin="0,-10,0,12">
                        <Border Background="#4D5459" CornerRadius="9" Padding="8,2"
                                Margin="0,0,8,0">
                            <TextBlock Text="READ ONLY" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{StaticResource TextMain}"/>
                        </Border>
                        <TextBlock Text="Source: website attendance tool · records cannot be changed here"
                                   FontSize="13" Foreground="{StaticResource TextDim}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ComboBox Width="190" Margin="0,0,8,0"
                              ItemsSource="{Binding Months}"
                              SelectedItem="{Binding SelectedMonth}"
                              DisplayMemberPath="Label"/>
                    <Button Content="↻ Refresh" Padding="12,5" FontWeight="SemiBold"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap"
                       Foreground="{StaticResource Danger}" Margin="0,0,0,4"/>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,10">
                <TextBlock Text="{Binding SelectedMonth.Summary}" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" Margin="0,0,18,0"/>
                <ItemsControl ItemsSource="{Binding Legend}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Background}" CornerRadius="4"
                                    Padding="7,2" Margin="0,0,5,0">
                                <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}"
                                           FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SelectedMonth.Sections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="{Binding CardWidth}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"/>

                                    <!-- Operation-night headers align with the status cells below. -->
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Name" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDim}"
                                                   VerticalAlignment="Bottom"/>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Nights}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DateLabel}" Width="58"
                                                               Margin="0,0,4,0" FontSize="12.5"
                                                               FontWeight="SemiBold" TextAlignment="Center"
                                                               Foreground="{StaticResource TextDim}"
                                                               ToolTip="{Binding ToolTip}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="14"
                                                               Foreground="{StaticResource TextMain}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}"/>
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="58" Height="30" Margin="0,0,4,0"
                                                                        CornerRadius="4"
                                                                        Background="{Binding Background}"
                                                                        BorderBrush="#44000000" BorderThickness="1"
                                                                        ToolTip="{Binding Label}">
                                                                    <TextBlock Text="{Binding ShortLabel}"
                                                                               FontSize="12.5" FontWeight="SemiBold"
                                                                               Foreground="{Binding Foreground}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>

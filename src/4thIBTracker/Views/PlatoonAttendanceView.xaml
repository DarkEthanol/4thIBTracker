<UserControl x:Class="FourthIBTracker.Views.PlatoonAttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <!-- Hidden fetcher: shares the forum login used by the app's browser tabs. -->
        <wv2:WebView2 x:Name="Fetcher" Width="0" Height="0" Visibility="Hidden"/>

        <DockPanel Margin="20">
            <DockPanel DockPanel.Dock="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Platoon Attendance"/>
                    <TextBlock Text="Read-only records from the website attendance tracker"
                               Foreground="{StaticResource TextDim}" Margin="0,-10,0,12"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ComboBox Width="190" Margin="0,0,8,0"
                              ItemsSource="{Binding Sections}"
                              SelectedItem="{Binding SelectedSection}"
                              DisplayMemberPath="Name"/>
                    <Button Content="↻ Refresh" Padding="12,5" FontWeight="SemiBold"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap"
                       Foreground="{StaticResource Danger}" Margin="0,0,0,4"/>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,10">
                <TextBlock Text="{Binding SelectedSection.Summary}" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" Margin="0,0,18,0"/>
                <ItemsControl ItemsSource="{Binding Legend}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Background}" CornerRadius="4"
                                    Padding="7,2" Margin="0,0,5,0">
                                <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}"
                                           FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <ItemsControl ItemsSource="{Binding SelectedSection.Events}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding DateLabel}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Name}"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextMain}"
                                                   TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Marks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Background}" CornerRadius="4"
                                                        Padding="8,4" Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Member}" FontWeight="SemiBold"
                                                                   Foreground="{Binding Foreground}"/>
                                                        <TextBlock Text="  ·  " Foreground="{Binding Foreground}"/>
                                                        <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>

<UserControl x:Class="FourthIBTracker.Views.PlatoonAttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <!-- Hidden fetcher: shares the forum login used by the app's browser tabs. -->
        <wv2:WebView2 x:Name="Fetcher" Width="0" Height="0" Visibility="Hidden"/>

        <DockPanel Margin="20">
            <DockPanel DockPanel.Dock="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Platoon Attendance"/>
                    <TextBlock Text="Read-only records from the website attendance tracker"
                               Foreground="{StaticResource TextDim}" Margin="0,-10,0,12"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ComboBox Width="190" Margin="0,0,8,0"
                              ItemsSource="{Binding Months}"
                              SelectedItem="{Binding SelectedMonth}"
                              DisplayMemberPath="Label"/>
                    <Button Content="↻ Refresh" Padding="12,5" FontWeight="SemiBold"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap"
                       Foreground="{StaticResource Danger}" Margin="0,0,0,4"/>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,10">
                <TextBlock Text="{Binding SelectedMonth.Summary}" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" Margin="0,0,18,0"/>
                <ItemsControl ItemsSource="{Binding Legend}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Background}" CornerRadius="4"
                                    Padding="7,2" Margin="0,0,5,0">
                                <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}"
                                           FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <DataGrid x:Name="AttendanceGrid"
                      ItemsSource="{Binding SelectedMonth.Events}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#20FFFFFF"
                      VerticalGridLinesBrush="#30FFFFFF"
                      Background="Transparent"
                      RowBackground="{StaticResource BgPanel}"
                      AlternatingRowBackground="#2B2F33"
                      Foreground="{StaticResource TextMain}"
                      BorderThickness="0"
                      RowHeight="42" FontSize="14"
                      ColumnHeaderHeight="68"
                      FrozenColumnCount="2"
                      CanUserResizeRows="False" CanUserReorderColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      EnableColumnVirtualization="False" EnableRowVirtualization="True"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#20FFFFFF"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>

<UserControl x:Class="FourthIBTracker.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FourthIBTracker.Views"
             xmlns:vm="clr-namespace:FourthIBTracker.ViewModels">
    <UserControl.Resources>
        <views:StatusBrushConverter x:Key="StatusBrush"/>
        <views:StatusLabelConverter x:Key="StatusLabel"/>
        <views:StatusShortLabelConverter x:Key="StatusShort"/>
        <views:StatusKeyConverter x:Key="StatusKey"/>
    </UserControl.Resources>
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Attendance"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource Warn}">
                    <Run Text="{Binding DirtyCount, Mode=OneWay}"/><Run Text=" unsaved"/>
                </TextBlock>
                <Button Content="Save to Sheet" Padding="12,5" FontWeight="SemiBold"
                        Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                <Button Content="↻ Refresh" Padding="10,5" Command="{Binding LoadCommand}"/>
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}"
                   Foreground="{StaticResource Accent}" Margin="0,0,0,2"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap"
                   Foreground="{StaticResource Danger}" Margin="0,0,0,2"/>
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,6">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Status palette -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgSidebar}"
                CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="PAINT WITH:" FontSize="13.5" FontWeight="Bold"
                           Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <ListBox ItemsSource="{x:Static vm:AttendanceCellViewModel.StatusOptions}"
                         SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="chip" CornerRadius="14" Padding="12,5" Margin="0,0,8,0"
                                                Background="#26FFFFFF" BorderThickness="2"
                                                BorderBrush="Transparent" Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="chip" Property="BorderBrush"
                                                        Value="{StaticResource Accent}"/>
                                                <Setter TargetName="chip" Property="Background" Value="#40FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="chip" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2"
                                           Margin="0,0,6,0" VerticalAlignment="Center"
                                           Stroke="#66000000" StrokeThickness="0.5"
                                           Fill="{Binding Converter={StaticResource StatusBrush}}"/>
                                <TextBlock Text="{Binding Converter={StaticResource StatusLabel}}"
                                           FontSize="15" Foreground="{StaticResource TextMain}"
                                           VerticalAlignment="Center"/>
                                <Border Background="#33FFFFFF" CornerRadius="3" Padding="5,0"
                                        Margin="7,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Converter={StaticResource StatusKey}}"
                                               FontSize="11.5" FontWeight="Bold"
                                               Foreground="{StaticResource TextDim}"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Section cards -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="470">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"/>
                                <!-- Week header -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="W1" Width="56" FontSize="13" TextAlignment="Center"
                                                   Foreground="{StaticResource TextDim}"/>
                                        <TextBlock Text="W2" Width="56" FontSize="13" TextAlignment="Center"
                                                   Foreground="{StaticResource TextDim}"/>
                                        <TextBlock Text="W3" Width="56" FontSize="13" TextAlignment="Center"
                                                   Foreground="{StaticResource TextDim}"/>
                                        <TextBlock Text="W4" Width="56" FontSize="13" TextAlignment="Center"
                                                   Foreground="{StaticResource TextDim}"/>
                                        <TextBlock Text="W5" Width="56" FontSize="13" TextAlignment="Center"
                                                   Foreground="{StaticResource TextDim}"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="165"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="15"
                                                           Foreground="{StaticResource TextMain}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="52" Height="30" Margin="0,0,4,0"
                                                                    CornerRadius="4" Cursor="Hand"
                                                                    Background="{Binding Brush}"
                                                                    BorderBrush="#44000000" BorderThickness="1">
                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick"
                                                                                  Command="{Binding ApplyCommand}"/>
                                                                    <MouseBinding MouseAction="RightClick"
                                                                                  Command="{Binding ClearCommand}"/>
                                                                </Border.InputBindings>
                                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusShort}}"
                                                                           FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="#222"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>

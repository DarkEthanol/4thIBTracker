<UserControl x:Class="FourthIBTracker.Views.CoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Section Courses"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox Width="220" Margin="0,0,8,0"
                          ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding SelectedFilter}"/>
                <Button Content="↻ Refresh" Padding="10,5" Command="{Binding LoadCommand}"/>
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Border Background="#8FBC72" CornerRadius="5" Padding="10,3" Margin="0,0,6,0">
                <TextBlock Text="✓ Complete" FontSize="14" Foreground="#1E2124"/>
            </Border>
            <Border Background="#E8C15A" CornerRadius="5" Padding="10,3" Margin="0,0,6,0">
                <TextBlock Text="★ Advanced" FontSize="14" Foreground="#1E2124"/>
            </Border>
            <Border Background="#B85C5C" CornerRadius="5" Padding="10,3">
                <TextBlock Text="✗ Not done" FontSize="14" Foreground="#1E2124"/>
            </Border>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap"
                   Foreground="{StaticResource Danger}" Margin="0,0,0,4"/>
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"
                Padding="12" Margin="0,10,0,0" MaxHeight="250">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,7">
                    <TextBlock FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource Accent}">
                        <Run Text="COURSE TRACKER DISCREPANCIES — "/>
                        <Run Text="{Binding Discrepancies.Count, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding DiscrepancyStatus}"
                               Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="No discrepancies found between the tracker and website badges."
                           Foreground="{StaticResource Accent}" Margin="0,5,0,2">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Discrepancies.Count}" Value="0"/>
                                        <Condition Binding="{Binding DiscrepancyCheckComplete}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Discrepancies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#22000000" CornerRadius="5"
                                        Padding="8,6" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextMain}"/>
                                            <TextBlock Text="{Binding Section}" FontSize="11.5"
                                                       Foreground="{StaticResource TextDim}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Course}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Warn}"
                                                   TextWrapping="Wrap" Margin="8,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextDim}"
                                                   TextWrapping="Wrap" Margin="8,0"/>
                                        <Button Grid.Column="3" Content="Profile ↗" Padding="8,3"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                ToolTip="{Binding ProfileUrl}"
                                                Command="{Binding DataContext.OpenDiscrepancyProfileCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DataGrid x:Name="Grid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Vertical"
                  VerticalGridLinesBrush="#30FFFFFF"
                  Background="Transparent"
                  AlternationCount="2"
                  Foreground="{StaticResource TextMain}"
                  BorderThickness="0"
                  RowHeight="32" FontSize="15"
                  ColumnHeaderHeight="118"
                  FrozenColumnCount="1"
                  CanUserResizeRows="False" CanUserReorderColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  EnableColumnVirtualization="False" EnableRowVirtualization="True">
            <DataGrid.Resources>
                <!-- Let the selected row's background show through every cell. -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E8E6E3"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E8E6E3"/>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{StaticResource BgPanel}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="1,1,1,1"/>
                    <Style.Triggers>
                        <Trigger Property="AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#2B2F33"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#5365814E"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <StackPanel>
                                            <Border Background="{StaticResource BgSidebar}"
                                                    CornerRadius="4" Padding="10,6" Margin="0,10,0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="17" FontWeight="Bold"
                                                               Foreground="{StaticResource Accent}">
                                                        <Run Text="Section "/><Run Text="{Binding Name, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="13.5" Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextDim}">
                                                        <Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" soldiers"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <ItemsPresenter/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
        </DataGrid>
    </DockPanel>
</UserControl>

<UserControl x:Class="FourthIBTracker.Views.CoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Section Courses"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox Width="220" Margin="0,0,8,0"
                          ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding SelectedFilter}"/>
                <Button Content="↻ Refresh" Padding="10,5" Command="{Binding LoadCommand}"/>
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Border Background="#8FBC72" CornerRadius="5" Padding="10,3" Margin="0,0,6,0">
                <TextBlock Text="✓ Complete" FontSize="14" Foreground="#1E2124"/>
            </Border>
            <Border Background="#E8C15A" CornerRadius="5" Padding="10,3" Margin="0,0,6,0">
                <TextBlock Text="★ Advanced" FontSize="14" Foreground="#1E2124"/>
            </Border>
            <Border Background="#B85C5C" CornerRadius="5" Padding="10,3">
                <TextBlock Text="✗ Not done" FontSize="14" Foreground="#1E2124"/>
            </Border>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap"
                   Foreground="{StaticResource Danger}" Margin="0,0,0,4"/>
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <DataGrid x:Name="Grid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Vertical"
                  VerticalGridLinesBrush="#30FFFFFF"
                  Background="Transparent"
                  RowBackground="{StaticResource BgPanel}"
                  AlternatingRowBackground="#2B2F33"
                  Foreground="{StaticResource TextMain}"
                  BorderThickness="0"
                  RowHeight="32" FontSize="15"
                  ColumnHeaderHeight="118"
                  FrozenColumnCount="1"
                  CanUserResizeRows="False" CanUserReorderColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  EnableColumnVirtualization="False" EnableRowVirtualization="True">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <StackPanel>
                                            <Border Background="{StaticResource BgSidebar}"
                                                    CornerRadius="4" Padding="10,6" Margin="0,10,0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="17" FontWeight="Bold"
                                                               Foreground="{StaticResource Accent}">
                                                        <Run Text="Section "/><Run Text="{Binding Name, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="13.5" Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextDim}">
                                                        <Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" soldiers"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <ItemsPresenter/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
        </DataGrid>
    </DockPanel>
</UserControl>

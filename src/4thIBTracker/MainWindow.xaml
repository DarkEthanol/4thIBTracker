<Window x:Class="FourthIBTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="4thIB Tracker" Height="860" Width="1360"
        Icon="/Assets/app.ico"
        FontSize="16"
        Background="{StaticResource BgDark}"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Danger}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0" Background="{StaticResource BgSidebar}"
                BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="UpdateButton" Style="{StaticResource CaptionButton}"
                            Width="Auto" Padding="12,0" Margin="0,5"
                            Background="{StaticResource AccentDim}"
                            Foreground="{StaticResource TextMain}"
                            Content="{Binding BannerText}"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanToVisibility}}"
                            ToolTip="An update is ready" Click="NavUpdate_Click"/>
                    <Button Style="{StaticResource CaptionButton}" Content="⚙"
                            ToolTip="Settings" Click="NavSettings_Click"/>
                    <Button Style="{StaticResource CaptionButton}" Content="—"
                            ToolTip="Minimise" Click="Minimize_Click"/>
                    <Button Style="{StaticResource CaptionButton}" Content="▢"
                            ToolTip="Maximise / restore" Click="MaximizeRestore_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="✕"
                            ToolTip="Close" Click="Close_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="/Assets/app.ico" Width="18" Height="18"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="4thIB TRACKER" FontSize="13.5" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}" Margin="9,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleBarSubtitle" FontSize="13"
                               Foreground="{StaticResource TextDim}" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0">
                        <TextBlock Text="VIEWS" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                   Margin="16,0,0,4"/>
                        <Button Style="{StaticResource NavButton}" Content="  Dashboard"   Click="NavDashboard_Click"/>
                        <Button x:Name="TodoNavButton" Style="{StaticResource NavButton}"
                                Click="NavTodo_Click">
                            <Grid Width="182">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="  Todo" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{StaticResource Danger}"
                                        CornerRadius="10" MinWidth="22" Height="22" Padding="6,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OverdueCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding OverdueCount}" Foreground="White"
                                               FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Content="  Attendance"  Click="NavAttendance_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="  Courses"     Click="NavCourses_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="  Medals"      Click="NavCampaignMedals_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="  CEFO"        Click="NavCefo_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="  Fill-ins"    Click="NavFillIns_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="  Links"       Click="NavLinks_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="  NCO Courses" Click="NavForumCourses_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="  Patrol Reports" Click="NavPatrolReports_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="  Training Reports" Click="NavTrainingReports_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="  Sgt's Address" Click="NavAddress_Click"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Margin="0,18,0,0">
                        <TextBlock Text="SHEETS (BROWSER)" FontSize="11.5"
                                   Foreground="{StaticResource TextDim}" Margin="16,0,0,4"/>
                        <ItemsControl x:Name="BrowserTabList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavButton}"
                                            Content="{Binding Name}" Tag="{Binding}"
                                            Click="NavBrowserTab_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" x:Name="FooterText" Margin="16,0,8,12"
                               VerticalAlignment="Bottom" FontSize="11.5"
                               Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                    <Border/>
                </DockPanel>
            </Border>

            <!-- Content -->
            <ContentControl Grid.Column="1" x:Name="ContentHost" Margin="0"/>
        </Grid>
    </Grid>
</Window>
